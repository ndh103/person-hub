{
  // Cloudflare Worker (API). Runtime types come from `wrangler types`
  // (worker-configuration.d.ts, generated by `npm run typecheck`).
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.worker.tsbuildinfo",
    "lib": ["ES2023"],
    "types": ["./worker-configuration.d.ts"]
  },
  "include": ["src/worker", "src/features/*/server"]
}
