# Copy to .env.local and fill in. Never commit real values.
# See docs/architecture/auth.md (Configuration) for the Supabase dashboard settings.

# Browser-safe (bundled into client code by design; access is enforced by Supabase Auth + RLS)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me
# Canonical origin of this app, no trailing slash. Used for auth redirect URLs and the Origin check.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server secrets: none are needed for sign-in. Do not add the Supabase secret
# (service-role) key to this app without a documented need (CLAUDE.md).
