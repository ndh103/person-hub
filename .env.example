# SPA build settings. Copy to .env.local and fill in. Never commit real values.
# See docs/architecture/auth.md (Configuration) for the Supabase dashboard settings.

# Browser-safe: Vite bundles VITE_* values into client code by design. Access is
# enforced by Supabase Auth + RLS, not by keeping these secret.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me

# The Worker (API) reads its own settings from .dev.vars; see .dev.vars.example.
# Do not add the Supabase secret (service-role) key anywhere without a
# documented need (CLAUDE.md).
