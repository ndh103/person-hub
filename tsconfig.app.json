{
  // Browser code: the SPA. Server modules are type-checked by tsconfig.worker.json;
  // eslint.config.js stops the SPA from importing them.
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "types": ["vite/client"]
  },
  "include": ["src"],
  "exclude": ["src/worker", "src/features/*/server"]
}
