{
  // One Worker serves the SPA (static assets) and the JSON API on the same
  // origin. See docs/architecture/decisions/ADR-0003-spa-and-worker-api.md.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "person-hub",
  "main": "./src/worker/index.ts",
  "compatibility_date": "2026-10-01",
  "assets": {
    // Unknown paths get index.html so client-side routes survive a reload.
    "not_found_handling": "single-page-application",
    // Only API requests run Worker code; everything else is a static asset.
    "run_worker_first": ["/api/*"]
  },
  // SUPABASE_URL and SUPABASE_PUBLISHABLE_KEY come from .dev.vars locally and
  // from the deploy workflow in production (`wrangler deploy --var`, see
  // .github/workflows/ci-deploy.yml).
  "observability": { "enabled": true }
}
